{
  "name": "momotalk-ai",
  "version": "1.0.0",
  "description": "Blue Archive MomoTalk Interactive AI Chat Application with Multi-student Roleplay, Groq/Gemini, and Life Rhythm Simulation",
  "repository": {
    "type": "git",
    "url": "https://github.com/hirarara74/momotalk_AI.git"
  },
  "author": "hirarara74",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build && node -e \"require('fs').copyFileSync('docs/index.html', 'docs/404.html')\"",
    "type-check": "vue-tsc --noEmit --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "test": "vitest run",
    "deploy": "node -e \"require('fs').copyFileSync('docs/index.html', 'docs/404.html')\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@kangc/v-md-editor": "^2.3.17",
    "@types/vue-router": "^2.0.0",
    "axios": "^1.4.0",
    "tiny-pinyin": "^1.3.2",
    "vue": "^3.3.4",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.2.2",
    "vue3-popper": "^1.5.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.2.0",
    "@tsconfig/node18": "^2.0.1",
    "@types/prismjs": "^1.26.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitejs/plugin-vue-jsx": "^3.0.1",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.39.0",
    "eslint-plugin-vue": "^9.11.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "sass": "^1.63.6",
    "typescript": "~5.0.4",
    "vite": "^4.3.9",
    "vite-plugin-top-level-await": "^1.3.1",
    "vitest": "^1.6.1",
    "vue-tsc": "^1.6.5"
  }
}
