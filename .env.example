# MomoTalk AI - Environment Variables (Optional for local development)
#
# Users can enter their API key directly in the web app UI (Settings modal ⚙️).
# For local automated development or default pre-population, you can copy this file to `.env.local`
# and fill in your keys.

# Groq API Key (Get free key at https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# Google Gemini API Key (Get at https://aistudio.google.com/)
VITE_GEMINI_API_KEY=

# OpenAI API Key (Optional)
VITE_OPENAI_API_KEY=

# Anthropic Claude API Key (Optional)
VITE_CLAUDE_API_KEY=
